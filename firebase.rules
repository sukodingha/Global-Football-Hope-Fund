rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.adminRole == true;
    }

    function isOwn(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isActiveUser() {
      return isSignedIn() && (!('moderationStatus' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data) || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.moderationStatus != 'suspended');
    }

    function notBlocked(targetUid) {
      return !exists(/databases/$(database)/documents/users/$(request.auth.uid)/blockedUsers/$(targetUid));
    }

    function canModifyUserProfile(userId) {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      let protectedMetrics = ['predictionPoints', 'postCount'];
      let rewardFields = [
        'rewardPoints', 'currentStreak', 'lastLoginDate', 'totalRewardsEarned', 'walletBalance', 'walletCurrency', 'lastRewardDate'
      ];
      return isOwn(userId) && !changedKeys.hasAny(protectedMetrics) &&
        (!changedKeys.hasAny(rewardFields) || changedKeys.hasOnly(rewardFields));
    }

    function canUpdateOwnPredictionPoints(userId) {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      let previousPoints = resource.data.get('predictionPoints', 0);
      let nextPoints = request.resource.data.get('predictionPoints', 0);
      let pointsDelta = nextPoints - previousPoints;
      let rewardChanged = changedKeys.hasAny(['rewardPoints', 'totalRewardsEarned']);
      return isOwn(userId) &&
        changedKeys.hasAny(['predictionPoints']) &&
        changedKeys.hasOnly(['predictionPoints', 'updatedAt', 'rewardPoints', 'totalRewardsEarned']) &&
        nextPoints is int && pointsDelta > 0 && pointsDelta <= 7 &&
        (!rewardChanged || (
          pointsDelta == 7 &&
          changedKeys.hasAll(['rewardPoints', 'totalRewardsEarned']) &&
          request.resource.data.get('rewardPoints', 0) == resource.data.get('rewardPoints', 0) + 50 &&
          request.resource.data.get('totalRewardsEarned', 0) == resource.data.get('totalRewardsEarned', 0) + 50
        ));
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId &&
        !('rewardPoints' in request.resource.data) &&
        !('walletBalance' in request.resource.data) &&
        !('predictionPoints' in request.resource.data) &&
        !('postCount' in request.resource.data);
      allow update: if isSignedIn() && (canModifyUserProfile(userId) || canUpdateOwnPredictionPoints(userId) || isAdmin());
      allow delete: if isAdmin();

      match /blockedUsers/{targetUid} {
        allow read, write: if isOwn(userId);
      }

      match /blockedBy/{blockerUid} {
        allow read: if isOwn(userId);
        allow write: if isAdmin();
      }
      match /teammates/{teammateId} {
        allow read: if isSignedIn();
        allow write: if isOwn(userId);
      }
    }

    match /polls/{pollId} {
      function isOpenPoll() {
        return resource.data.get('active', false) == true ||
          resource.data.get('isActive', false) == true ||
          resource.data.get('status', '') == 'active';
      }

      function isSinglePollVote() {
        let oldVotes = resource.data.get('votes', {});
        let newVotes = request.resource.data.get('votes', {});
        let oldCounts = resource.data.get('voteCounts', {});
        let newCounts = request.resource.data.get('voteCounts', {});
        let optionId = newVotes.get(request.auth.uid, '');
        return isOpenPoll() &&
          !oldVotes.keys().hasAny([request.auth.uid]) &&
          !resource.data.get('voterIds', []).hasAny([request.auth.uid]) &&
          optionId is string &&
          newVotes.diff(oldVotes).affectedKeys().hasOnly([request.auth.uid]) &&
          newCounts.diff(oldCounts).affectedKeys().hasOnly([optionId]) &&
          newCounts.get(optionId, 0) == oldCounts.get(optionId, 0) + 1 &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes', 'voteCounts']);
      }

      allow read: if isSignedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isActiveUser() && isSinglePollVote());
    }

    match /posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isActiveUser() && request.resource.data.authorId == request.auth.uid && !request.resource.data.deleted;
      allow update: if isSignedIn() && (resource.data.authorId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    match /media/{mediaId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isActiveUser() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    match /predictions/{predictionId} {
      allow read: if isSignedIn();
      allow create, delete: if false;
      allow update: if isAdmin() || (
        isActiveUser() &&
        resource.data.userId == request.auth.uid &&
        resource.data.status == 'pending' &&
        resource.data.ticketStatus == 'pending' &&
        resource.data.ticketId is string &&
        request.resource.data.status in ['correct', 'incorrect'] &&
        request.resource.data.ticketStatus in ['won', 'lost'] &&
        request.resource.data.ticketMatchCount == 7 &&
        request.resource.data.ticketCorrectCount is int &&
        request.resource.data.ticketCorrectCount >= 0 &&
        request.resource.data.ticketCorrectCount <= 7 &&
        ((request.resource.data.ticketStatus == 'won' &&
          request.resource.data.ticketCorrectCount == 7 &&
          request.resource.data.ticketReward == 50) ||
         (request.resource.data.ticketStatus == 'lost' &&
          request.resource.data.ticketCorrectCount < 7 &&
          request.resource.data.ticketReward == 0)) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'ticketStatus', 'ticketCorrectCount', 'ticketMatchCount', 'ticketReward',
          'pointsAwarded', 'finalScore', 'settledAt', 'lostExpiresAt'
        ])
      );
    }

    match /predictionDailyLimits/{summaryId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create, update, delete: if false;
    }

    match /transactions/{transactionId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create, update, delete: if false;
    }

    match /walletBalance/{userId} {
      allow read: if isOwn(userId);
      allow create, update, delete: if false;
    }

    match /messages/{messageId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isActiveUser() && request.resource.data.senderId == request.auth.uid && notBlocked(request.resource.data.recipientId);
      allow update: if isSignedIn() && (resource.data.senderId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    match /notifications/{uid}/items/{notifId} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow update: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow delete: if isAdmin();
    }

    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && request.resource.data.reporterId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /liveStreams/{streamId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isActiveUser() && request.resource.data.hostId == request.auth.uid;
      allow update: if isSignedIn() && (resource.data.hostId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    match /chats/{chatId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isActiveUser();
    }

    match /liveChats/{chatId}/messages/{messageId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isActiveUser() && request.resource.data.authorId == request.auth.uid;
      allow update: if isSignedIn() && (resource.data.authorId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    match /community_chats/{chatId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isActiveUser();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /donations/{docId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
